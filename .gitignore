# EzRoom Android - Professional Gitignore

# Gradle files
.gradle/
build/
/*/build/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# Kotlin
.kotlin/
kotlin-js-store/
scripts/

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/
local.properties
lint/

# Signing files
*.jks
*.keystore
*.p12
signing.properties

# Secrets
secrets.xml

# Device/Emulator
*.apk
*.apks
*.aab

# OS files
.DS_Store
Thumbs.db
*.swp
*~
.AppleDouble
.LSOverride

# Build artifacts
*.log
/captures

# --- Internal Documentation & Tooling (Exclude from Git) ---
.artifacts/
.skills/
.cursor/
.clinerules
.cline/
*.artifact.md
ANDROID_APP_DETAIL_STATE.md
android_app_spec.md
EzRoom_Technical_Spec_v1.0.md
