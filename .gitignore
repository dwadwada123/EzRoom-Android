# EzRoom Android - Professional Gitignore

# Gradle files
.gradle/
build/
/*/build/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# Kotlin
.kotlin/
kotlin-js-store/
scripts/

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/
local.properties
lint/
# Google Services (Exclude by default for security)
# google-services.json

# Signing files
*.jks
*.keystore
*.p12
signing.properties

# Secrets
secrets.xml

# Device/Emulator
*.apk
*.apks
*.aab

# OS files
.DS_Store
Thumbs.db
*.swp
*~
.AppleDouble
.LSOverride

# Build artifacts
*.log
/captures

# AI/Agent Context (Internal context & skills)
.artifacts/
.skills/
.cursor/
.clinerules
.cline/
ANDROID_APP_DETAIL_STATE.md
# android_app_spec.md is NOT ignored as it is for syncing with Web Admin
